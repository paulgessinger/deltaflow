# Copy to .env and edit. Read by both `uv run deltaflow serve` (pydantic-settings
# loads .env directly) and docker compose. Never commit the filled-in version --
# .env is gitignored.

# --- identity of this deployment -------------------------------------------
# The `aud` claim submitters must request, and what stops an OIDC token minted
# for someone else's service being replayed here. It must match exactly what
# the CI action asks for: with the bundled actions that is the `server` input,
# so under a tunnel both are the tunnel URL.
DELTAFLOW_AUDIENCE=https://your-tunnel.example.dev

# fnmatch patterns, JSON-encoded. Empty means nothing is accepted.
DELTAFLOW_ALLOWED_REPOS=["paulgessinger/deltaflow"]

# The branch whose pushes may write baselines. Everything else is PR context.
DELTAFLOW_DEFAULT_BRANCH=main

# --- GitHub App -------------------------------------------------------------
# Needed to post pull request comments and to verify fork submissions. Ingest
# on the OIDC and token paths needs none of this.
DELTAFLOW_GITHUB_APP_ID=
DELTAFLOW_GITHUB_INSTALLATION_ID=

# The PEM, on one line, with literal \n where the newlines were:
#   awk 'BEGIN{ORS="\\n"} {print}' your-app.private-key.pem
# The client repairs that form on load, because passing a real multi-line value
# through an env var or a compose file mangles it in ways PyJWT reports very
# far from the cause.
DELTAFLOW_GITHUB_PRIVATE_KEY=

# Run every path for real -- OIDC, attestation, ingest -- but log what would
# have been posted instead of writing to anyone's pull request. Start here.
# Note the lease (fork) path returns 503 while this is on: it has nothing to
# attest against.
DELTAFLOW_GITHUB_DRY_RUN=true

# --- local stack ------------------------------------------------------------
# Host ports for docker compose. Not read by the app; set DF_HOST_PORT if
# something already owns 8000, because Docker Desktop will not always tell you
# that it does -- the container reports healthy while the published port
# resolves to the other process.
#DF_HOST_PORT=8000
#DF_GRAFANA_PORT=3000

# --- storage and behaviour --------------------------------------------------
DELTAFLOW_DATABASE_URL=sqlite:////data/deltaflow.db
DELTAFLOW_BASELINE_WINDOW=50

# Turn on only behind a proxy that overwrites X-Forwarded-For. Trusting the
# header without one lets any caller forge their address and bypass the
# per-address claim limit entirely. A tunnel is not such a proxy.
DELTAFLOW_TRUST_FORWARDED_FOR=false
